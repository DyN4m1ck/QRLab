<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QRLab.View.ViewModels" xmlns:c="using:QRLab.View.Controls" xmlns:icons="using:QRLab.View.Controls" x:Class="QRLab.View.Views.ComparisonView" x:DataType="vm:ComparisonViewModel">
  <Grid Margin="18" RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Classes="muted"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding Workspace.PreviousCommand}" ToolTip.Tip="Предыдущий образец">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <icons:SvgIcon Source="arrow-right" Width="12" Height="12" RenderTransform="rotate(180deg)" RenderTransformOrigin="50%,50%"/>
            <TextBlock Text="Предыдущий"/>
          </StackPanel>
        </Button>
        <TextBlock Text="{Binding Workspace.Position}" Classes="muted" Margin="6,0"/>
        <Button Command="{Binding Workspace.NextCommand}" ToolTip.Tip="Следующий образец">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Text="Следующий"/>
            <icons:SvgIcon Source="arrow-right" Width="12" Height="12"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,280" ColumnSpacing="12">
      <Grid RowDefinitions="*,Auto,210" RowSpacing="12">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsSideBySide}">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,*,52">
              <Border Classes="panelHead">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="А   Исходник" Classes="heading"/>
                  <StackPanel Orientation="Horizontal" Spacing="7" Grid.Column="1">
                    <icons:SvgIcon Source="lock" Foreground="{DynamicResource ActiveIconBrush}" Width="12" Height="12"/>
                    <TextBlock Text="Защищён" Classes="accent" FontSize="10"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="#0D1112" Padding="20">
                <c:CodePreview Modules="{Binding Workspace.SelectedSample.Modules}" Zoom="{Binding Zoom}"/>
              </Border>
              <StackPanel Grid.Row="2" Margin="12,8" Spacing="4">
                <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="mono" FontSize="10"/>
                <TextBlock Text="Кадр 00 • исходное изображение" Classes="muted" FontSize="9"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <Grid RowDefinitions="Auto,*,52">
              <Border Classes="panelHead">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Б   После мутаций" Classes="heading"/>
                  <TextBlock Grid.Column="1" Text="{Binding Workspace.SelectedSample.Status}" Classes="muted" FontSize="10"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="#0D1112" Padding="20">
                <c:CodePreview Modules="{Binding PreviewModules}" Zoom="{Binding Zoom}"/>
              </Border>
              <StackPanel Grid.Row="2" Margin="12,8" Spacing="4">
                <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="mono" FontSize="10"/>
                <TextBlock Text="Последний кадр цепочки" Classes="muted" FontSize="9"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Border Classes="card" IsVisible="{Binding IsOverlay}" Padding="24">
          <Grid>
            <c:CodePreview Modules="{Binding Workspace.SelectedSample.Modules}" Zoom="{Binding Zoom}"/>
            <c:CodePreview Modules="{Binding PreviewModules}" Zoom="{Binding Zoom}" Opacity="{Binding OverlayFraction}"/>
            <Border Background="#CC1B2022" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4">
              <TextBlock Text="А + Б / наложение" Classes="accent"/>
            </Border>
          </Grid>
        </Border>
        <Border Classes="card" IsVisible="{Binding IsDifference}" Padding="24">
          <Grid>
            <c:CodePreview Modules="{Binding DifferenceModules}" Zoom="{Binding Zoom}" Difference="True"/>
            <Border Background="#CC1B2022" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4">
              <TextBlock Text="Различия выделены коралловым" Classes="danger"/>
            </Border>
          </Grid>
        </Border>
        <Border Grid.Row="1" Classes="card" Padding="8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ListBox Classes="tabs iconTabs" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, Mode=TwoWay}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:SvgIcon Source="{Binding Converter={StaticResource IconName}}"/>
                    <TextBlock Text="{Binding}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsOverlay}" HorizontalAlignment="Center">
              <TextBlock Text="Слой Б" Classes="muted"/>
              <Slider Width="130" Minimum="0" Maximum="100" Value="{Binding OverlayOpacity, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <icons:SvgIcon Source="link"/>
                <TextBlock Text="Масштаб" Classes="muted"/>
              </StackPanel>
              <Slider Width="120" Minimum="50" Maximum="200" Value="{Binding Zoom, Mode=TwoWay}"/>
              <TextBlock Text="{Binding Zoom, StringFormat={}{0:N0}%}" Classes="accent" Width="40"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="2" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <Border Classes="panelHead">
              <TextBlock Text="Результаты распознавания" Classes="heading"/>
            </Border>
            <StackPanel Grid.Row="1" Margin="14" Spacing="10">
              <Grid ColumnDefinitions="*,*,*">
                <TextBlock Text="ПОКАЗАТЕЛЬ" Classes="muted" FontSize="9"/>
                <TextBlock Grid.Column="1" Text="А · ИСХОДНИК" Classes="muted" FontSize="9"/>
                <TextBlock Grid.Column="2" Text="Б · ПОСЛЕ МУТАЦИЙ" Classes="muted" FontSize="9"/>
              </Grid>
              <Border Height="1" Background="#303839"/>
              <Grid ColumnDefinitions="*,*,*">
                <TextBlock Text="Содержимое" Classes="muted"/>
                <TextBlock Grid.Column="1" Text="{Binding Workspace.SelectedSample.Content}" Classes="accent" FontFamily="Consolas" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="{Binding Workspace.SelectedSample.Decoded}" Classes="mono" FontSize="11"/>
              </Grid>
              <Grid ColumnDefinitions="*,*,*">
                <TextBlock Text="Время обработки" Classes="muted"/>
                <TextBlock Grid.Column="1" Text="—" Classes="muted"/>
                <TextBlock Grid.Column="2" Text="{Binding Workspace.SelectedSample.Time}" Classes="mono" FontSize="11"/>
              </Grid>
              <Grid ColumnDefinitions="*,*,*">
                <TextBlock Text="Состояние" Classes="muted"/>
                <TextBlock Grid.Column="1" Text="Оригинальные данные" Classes="muted"/>
                <TextBlock Grid.Column="2" Text="{Binding Workspace.SelectedSample.Status}" Classes="muted"/>
              </Grid>
              <TextBlock Text="ⓘ  Результаты появляются после демонстрационного прогона на экране считывания." Classes="muted" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="12">
          <Border Classes="card">
            <StackPanel>
              <Border Classes="panelHead">
                <TextBlock Text="{Binding Workspace.SelectedSample.Name}" Classes="heading"/>
              </Border>
              <StackPanel Margin="14" Spacing="12">
                <TextBlock Text="{Binding Workspace.SelectedSample.Content}" Classes="mono" FontSize="16"/>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="lock" Foreground="{DynamicResource ActiveIconBrush}" Width="12" Height="12"/>
                  <TextBlock Text="Исходник защищён от изменений" Classes="accent" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="Текущий образец общий для всех четырёх экранов." Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel>
              <Border Classes="panelHead">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="config"/>
                  <TextBlock Text="Параметры операций" Classes="heading"/>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Workspace.SelectedSample.Operations}" Margin="14">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OperationViewModel">
                    <Grid ColumnDefinitions="28,*" Margin="0,8">
                      <TextBlock Text="{Binding Number}" Classes="accent" FontSize="10"/>
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Details}" Classes="muted" FontSize="10"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Command="{ReflectionBinding $parent[Window].DataContext.NavigateCommand}" CommandParameter="02" Margin="14" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <icons:SvgIcon Source="arrow-right"/>
                  <TextBlock Text="Открыть в мутациях"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="12">
              <TextBlock Text="В контексте набора" Classes="heading"/>
              <TextBlock Text="{Binding Workspace.SelectedSample.Chain}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="Переключайте образцы кнопками вверху. Для анализа ошибки выберите кадр в редакторе мутаций." Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
