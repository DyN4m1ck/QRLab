<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QRLab.View.ViewModels" xmlns:views="using:QRLab.View.Views" xmlns:icons="using:QRLab.View.Controls" x:Class="QRLab.View.Views.MainWindow" x:DataType="vm:MainWindowViewModel" Title="QRLab — лаборатория устойчивости кодов" Width="1440" Height="940" MinWidth="1180" MinHeight="760">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:GenerationViewModel}">
      <views:GenerationView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MutationsViewModel}">
      <views:MutationsView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReadingViewModel}">
      <views:ReadingView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ComparisonViewModel}">
      <views:ComparisonView/>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid RowDefinitions="42,*,30,76">
    <Border Background="#1A1F21" BorderBrush="#303839" BorderThickness="0,0,0,1" Padding="20,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <icons:SvgIcon Source="logo" Width="20" Height="20" Foreground="#75D9BE"/>
          <TextBlock Text="QRLab" FontWeight="Bold" FontSize="15"/>
          <TextBlock Text="/" Classes="muted" Margin="12,0"/>
          <Button Classes="flat" Content="О проекте" Command="{Binding AboutCommand}"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="●" Classes="accent" FontSize="10" LetterSpacing="1"/>
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding SelectedScreen}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <Border Grid.Row="2" BorderBrush="#303839" BorderThickness="0,1,0,0" Padding="18,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="ПРОЕКТ / LP-04     •     НАБОР 01" Classes="muted" FontSize="10"/>
        <TextBlock Grid.Column="1" Text="{Binding Workspace.Notice}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="16,0" Classes="muted" FontSize="10"/>
        <TextBlock Grid.Column="2" Text="AVALONIA / MVVM" Classes="muted" FontSize="10"/>
      </Grid>
    </Border>
    <Border Grid.Row="3" Background="#0E1213">
      <ListBox Classes="nav" HorizontalAlignment="Center" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen, Mode=TwoWay}" SelectionMode="Single">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScreenViewModel">
            <StackPanel Spacing="7">
              <icons:SvgIcon Source="{Binding Number, Converter={StaticResource IconName}}" Width="20" Height="20" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontSize="11"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Border Grid.RowSpan="4" Background="#DD0B1011" IsVisible="{Binding IsAboutOpen}">
      <Border Classes="card" Width="480" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <TextBlock Text="QRLab / лаборатория кодов" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Четыре этапа исследования: создание набора, настройка искажений, распознавание и сравнение." TextWrapping="Wrap"/>
          <TextBlock Text="Интерактивный макет. Изображения и результаты демонстрационные. Настоящие генерация, обработка и декодирование будут подключены через сервисы." Classes="muted" TextWrapping="Wrap"/>
          <Button Classes="primary" Content="Вернуться к работе" Command="{Binding AboutCommand}"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
